# Scholar production settings.
# Copy to .env.production on the server, fill in every value, and never commit it.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Public address people open in the browser (no trailing slash).
# Without a domain yet: http://<VM public IP>:8091
PUBLIC_URL=http://YOUR_VM_IP:8091

# Host port for the app. 8091 is free on demo-vm (other apps use 8001, 8020,
# 8088, 8089, 8090, 5433, 5434). Use 127.0.0.1:8091 instead if a reverse
# proxy on the VM will serve it over HTTPS.
HTTP_BIND=8091

# Database - pick a long random password.
POSTGRES_USER=scholar
POSTGRES_PASSWORD=
POSTGRES_DB=scholar

# Signs login tokens. Generate with: openssl rand -hex 32
SECRET_KEY=

# First admin account, created on first start. Change the password after logging in.
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=

DEFAULT_CURRENT_YEAR=2026
LOG_LEVEL=INFO

# AI / OCR (optional)
AI_PROVIDER=builtin
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-4o-mini
OCR_ENABLED=true
