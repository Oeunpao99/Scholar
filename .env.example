# ==============================================================================
# SCHOLAR - BacII Student Enrollment Management System
# Environment Configuration Template
# ==============================================================================

# Database (PostgreSQL 17)
POSTGRES_USER=scholar
POSTGRES_PASSWORD=scholar
POSTGRES_DB=scholar
POSTGRES_PORT=5432

# Cache (Redis 7)
REDIS_PORT=6379

# Application Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Security & Secrets
SECRET_KEY=scholar_production_secret_key_super_secure_32_chars_min
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Superadmin Seed Account
FIRST_SUPERUSER_EMAIL=admin@scholar.local
FIRST_SUPERUSER_PASSWORD=ChangeMe123!

# Academic Year Default
DEFAULT_CURRENT_YEAR=2026

# AI & OCR Configuration
AI_PROVIDER=builtin
OCR_ENABLED=true
TESSERACT_CMD=/usr/bin/tesseract

# CORS & Frontend URLs
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api/v1
